<?xml version="1.0"?>
<package format="2">
    <name>ic_gvins</name>
    <version>1.0.0</version>
    <description>The IC-GVINS ROS Interface</description>

    <license>GPLv3</license>

    <maintainer email="thl@whu.edu.cn">hailiang</maintainer>
    <author email="thl@whu.edu.cn">hailiang</author>

    <buildtool_depend>catkin</buildtool_depend>

    <!-- NC-IC extension: explicit standard-message and generated-message
         dependencies for online-to-relocation communication. -->
    <build_depend>message_generation</build_depend>
    <exec_depend>message_runtime</exec_depend>

    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>roscpp</depend>
    <depend>sensor_msgs</depend>
    <depend>std_msgs</depend>
    <depend>tf2_ros</depend>
    <depend>visualization_msgs</depend>

</package>
