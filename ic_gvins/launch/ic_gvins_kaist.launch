<launch>
    <arg name="configfile" default="$(find ic_gvins)/../config/gvins-kaist-urban38.yaml"/>
    <arg name="enable_nc_reloc" default="true"/>
    <arg name="use_kaist_imu_converter" default="true"/>
    <arg name="raw_imu_topic" default="/imu/data_raw"/>
    <arg name="imu_topic" default="/imu/data_frd"/>
    <arg name="gnss_topic" default="/gps/fix"/>
    <arg name="image_topic" default="/stereo/left/image_color"/>

    <node if="$(arg use_kaist_imu_converter)" name="kaist_imu_frd_converter"
          pkg="ic_gvins" type="kaist_imu_frd_converter" output="screen">
        <param name="input_topic" value="$(arg raw_imu_topic)"/>
        <param name="output_topic" value="$(arg imu_topic)"/>
        <param name="output_frame_id" value="imu_frd"/>
        <param name="invalidate_orientation" value="true"/>
    </node>

    <node name="ic_gvins_node" pkg="ic_gvins" type="ic_gvins_ros" output="screen">
        <param name="imu_topic" value="$(arg imu_topic)"/>
        <param name="gnss_topic" value="$(arg gnss_topic)"/>
        <param name="image_topic" value="$(arg image_topic)"/>
        <param name="configfile" value="$(arg configfile)"/>
    </node>

    <node if="$(arg enable_nc_reloc)" name="nc_degraded_reloc_node" pkg="ic_gvins"
          type="ic_gvins_reloc_node" output="screen">
        <param name="relative_position_std" value="0.20"/>
        <param name="relative_yaw_std_deg" value="1.5"/>
        <param name="relative_reference_interval" value="0.5"/>
        <param name="maximum_nodes" value="5000"/>
        <param name="maximum_visualization_nodes" value="20000"/>
        <param name="min_recovery_anchors" value="10"/>
        <param name="max_recovery_tail_duration" value="10.0"/>
        <param name="optimize_num_iterations" value="20"/>
        <param name="tf_publish_rate" value="20.0"/>
    </node>

    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_map_broadcaster"
          args="0 0 0 -1 0 0 0 map world"/>
    <node name="visualisation" pkg="rviz" type="rviz" output="log"
          args="-d $(find ic_gvins)/../config/visualization.rviz"/>
</launch>
