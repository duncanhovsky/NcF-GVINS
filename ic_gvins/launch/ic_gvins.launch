<launch>
    <arg name="configfile" default=""/>
    <!-- NC-IC extension: the relocation process is intentionally independent
         from the online estimator, in the same operational style as a loop node. -->
    <arg name="enable_nc_reloc" default="true"/>

    <node name="ic_gvins_node" pkg="ic_gvins" type="ic_gvins_ros" output="screen">
        <param name="imu_topic" value="/imu0"/>
        <param name="gnss_topic" value="/gnss0"/>
        <param name="image_topic" value="/cam0"/>

        <!-- TODO: i2Nav-Robot dataset -->
        <!-- <param name="imu_topic" value="/adi/adis16465/imu"/>
        <param name="gnss_topic" value="/novatel/oem7/fix"/>
        <param name="image_topic" value="/avt_camera/left/image"/> -->

        <param name="configfile" value="$(arg configfile)"/>
    </node>

    <node if="$(arg enable_nc_reloc)" name="nc_degraded_reloc_node" pkg="ic_gvins"
          type="ic_gvins_reloc_node" output="screen">
        <param name="relative_position_std" value="0.15"/>
        <param name="relative_yaw_std_deg" value="1.0"/>
        <param name="relative_reference_interval" value="0.5"/>
        <param name="maximum_nodes" value="5000"/>
    </node>

    <!-- TODO: i2Nav-Robot dataset -->
    <!-- <node pkg="image_transport" type="republish" name="republish_left" output="screen" args="compressed raw">
        <remap from="in" to="/avt_camera/left/image"/>
        <remap from="out" to="/avt_camera/left/image"/>
    </node> -->

    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_map_broadcaster"
          args="0 0 0 -1 0 0 0 map world"/>
    <node name="visualisation" pkg="rviz" type="rviz" output="log" args="-d $(find ic_gvins)/../config/visualization.rviz"/>

</launch>
